{
    "policies": {
        "DontCheckDefaultBrowser": true,
        "SkipTermsOfUse": true,
        "DisableTelemetry": true,
        "GenerativeAI": {
            "Enabled": false
        },
        "HttpsOnlyMode": "enabled",
        "AutofillAddressEnabled": false,
        "AutofillCreditCardEnabled": false,
        "PasswordManagerEnabled": false,
        "FirefoxSuggest": {
            "WebSuggestions": false,
            "SponsoredSuggestions": false,
            "OnlineEnabled": false
        },
        "EnableTrackingProtection": {
            "Value": true,
            "Category": "strict"
        },
        "Homepage": {
            "StartPage": "none"
        },
        "NewTabPage": false,
        "FirefoxHome": {
            "Search": false,
            "Weather": false,
            "TopSites": false,
            "SponsoredTopSites": false,
            "Highlights": false,
            "Pocket": false,
            "Stories": false,
            "SponsoredPocket": false,
            "SponsoredStories": false,
            "Snippets": false,
            "Widgets": {
                "Enabled": false
            }
        },
        "SearchEngines": {
            "Default": "DuckDuckGo NOAI",
            "Add": [
                {
                    "Name": "DuckDuckGo NOAI",
                    "URLTemplate": "https://noai.duckduckgo.com/?q={searchTerms}",
                    "Method": "GET",
                    "Alias": "@noai",
                    "Description": "DuckDuckGo, without the AI",
                    "SuggestURLTemplate": "https://noai.duckduckgo.com/ac/?q={searchTerms}&type=list"
                }
            ],
            "Remove": [
                "Amazon.com",
                "eBay",
                "Perplexity"
            ],
            "PreventInstalls": false
        }
    }
}
